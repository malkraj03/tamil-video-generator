# Cloud Run Dockerfile - Optimized for Google Cloud Run
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    imagemagick \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
COPY requirements-cloud.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt -r requirements-cloud.txt

# Copy application files
COPY . .

# Create necessary directories
RUN mkdir -p /tmp/videos /tmp/audio

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/ || exit 1

# Run the Flask app
CMD exec gunicorn --bind :${PORT} --workers 1 --threads 8 --timeout 0 --access-logfile - --error-logfile - cloud_run_app:app
