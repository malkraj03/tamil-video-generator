# YouTube API Configuration (get these by running: python auth_setup.py)
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your_client_secret
YOUTUBE_REFRESH_TOKEN=1//your_refresh_token

# Video Configuration
VIDEO_DURATION=300
VIDEO_RESOLUTION=1280x720
VIDEO_FPS=24

# TTS Voice (options: male_in, female_in, male_lk, female_lk, male_my, female_my)
TTS_VOICE=male_in

# Scheduling (used by GitHub Actions cron, in UTC)
# 08:00 IST = 02:30 UTC
# 20:00 IST = 14:30 UTC
